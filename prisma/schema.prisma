generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum LeadStatus {
  INVITE_SENT      // convite mandado, aguardando aceite
  WAITING_REPLY    // conectado; mandamos mensagem (abertura/follow-up) e o lead ainda não respondeu
  CONVERSATION_OPEN // o lead já respondeu pelo menos uma vez — conversa de verdade
  NEEDS_HUMAN      // agente pediu handoff
  QUALIFIED        // pronto para fechar
  LOST             // sem resposta / recusou
}

enum MessageChannel {
  LINKEDIN
  EMAIL
  WHATSAPP
}

enum MessageSender {
  LEAD
  AGENT
  HUMAN
}

model Lead {
  id                String    @id @default(cuid())
  linkedinProfileUrl String   @unique
  linkedinProfileId  String?
  firstName         String?
  lastName          String?
  jobTitle          String?
  status            LeadStatus @default(INVITE_SENT)
  linkedinThreadId  String?   @unique
  needsHumanReason  String?
  // Quando o convite foi enviado (callback da edges.run). É o que conta pro limite
  // diário de convites — o status muda assim que o convite é aceito.
  invitedAt         DateTime?
  // Follow-ups enviados desde a última resposta do lead (zera quando ele responde).
  followUpsSent     Int       @default(0)
  // Follow-up próprio desta conversa (null = usa o da campanha ou o da conta).
  followUpMaxCount   Int?
  followUpDelayHours Int?
  // Canais além do LinkedIn (a secretária usa o que existir).
  email             String?
  phone             String?
  // Ficha pessoal: o que o corretor sabe da pessoa (família, time, aniversário,
  // como se conheceram...). A IA usa pra personalizar as mensagens.
  personal          String?   @db.Text
  // CRM: anotações livres do corretor (só ele vê) e etiquetas.
  notes             String?   @db.Text
  tags              String[]  @default([])
  // Nota 0-100 da IA: quanto o perfil combina com o cliente ideal (Settings.targetAudience).
  icpScore          Int?
  campaign          Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  campaignId        String?
  // Conversa arquivada no LinkedIn (lead perdido) — evita arquivar de novo.
  archivedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  messages          Message[]
}

// Campanha (opcional) = um público com uma oferta própria (ex.: "Saúde
// empresarial" x "RC profissional"). O texto dela soma às instruções gerais.
model Campaign {
  id           String         @id @default(cuid())
  name         String
  // Objetivo, em uma frase — só pra organização do corretor.
  description  String?
  // Cargos/setores/empresas: já vêm preenchidos na busca ao adicionar pessoas.
  audience     String[]       @default([])
  // Oferta / mensagem principal: é o que a IA lê.
  instructions String?        @db.Text
  // Máximo de pessoas na campanha (null = sem limite).
  maxLeads     Int?
  // Follow-up próprio da campanha (null = usa o padrão da conta).
  followUpMaxCount   Int?
  followUpDelayHours Int?
  // Pausada/finalizada: sem convites novos, aberturas nem follow-ups.
  status       CampaignStatus @default(ACTIVE)
  createdAt    DateTime       @default(now())
  leads        Lead[]
}

enum CampaignStatus {
  ACTIVE
  PAUSED
  FINISHED
}

// Cada busca de pessoas feita pelo Google (SerpApi/Serper). Serve pra contar o
// uso do mês e nunca passar da cota gratuita do provedor.
model WebSearchLog {
  id        String   @id @default(cuid())
  query     String   @db.Text
  page      Int      @default(0)
  results   Int      @default(0)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Inscrição de Web Push (um por navegador/aparelho do corretor).
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model Message {
  id        String        @id @default(cuid())
  lead      Lead          @relation(fields: [leadId], references: [id])
  leadId    String
  sender    MessageSender
  channel   MessageChannel @default(LINKEDIN)
  content   String
  linkedinMessageId String? @unique
  // E-mail: Message-ID (dedupe e resposta na mesma thread) e assunto.
  emailMessageId String? @unique
  subject   String?
  // Gmail: conversa (thread) em que a mensagem está, pra responder nela.
  emailThreadId String?
  // Rastreio de abertura dos e-mails enviados (imagem invisível). Sinal fraco:
  // alguns apps abrem sozinhos (Apple Mail), outros bloqueiam imagens (Outlook).
  openToken    String?   @unique
  openCount    Int       @default(0)
  firstOpenedAt DateTime?
  lastOpenedAt  DateTime?
  deliveredAt DateTime
  createdAt DateTime      @default(now())
}

model Settings {
  id                  String  @id @default("singleton")
  automationPaused    Boolean @default(true)
  // Como o corretor quer ser chamado no painel ("Boa noite, Lucas.").
  ownerName           String?
  dailyInviteLimit    Int     @default(18)
  dailyMessageLimit   Int     @default(25)
  linkedinIdentityId  String?
  // Link de login da identidade ainda não conectada: reaproveitado enquanto
  // válido, pra não criar (e pagar) uma identidade nova a cada clique.
  linkedinLoginLink   String?
  linkedinLoginLinkAt DateTime?
  agentInstructions   String? @db.Text
  // Modelo do Nous usado nas conversas (escolhido no admin depois do banco de
  // testes). Vazio = NOUS_MODEL do ambiente.
  agentModel          String?
  targetAudience      String? @db.Text
  // Follow-up automático: até followUpMaxCount mensagens, uma a cada
  // followUpDelayHours sem resposta. Depois disso o lead vira LOST.
  followUpMaxCount    Int     @default(2)
  followUpDelayHours  Int     @default(48)
  // Última checagem de convites aceitos (lista de conexões) — no máximo 1x/hora.
  connectionsCheckedAt DateTime?
  // Janela de envio automático (fuso de São Paulo): fora dela a IA não manda nada.
  workStartHour       Int     @default(8)
  workEndHour         Int     @default(19)
  workWeekdaysOnly    Boolean @default(true)
  // Um item por linha: nome, empresa ou link de perfil que nunca deve ser contatado.
  exclusionList       String? @db.Text
  // Ações Engagement opcionais — desligadas até o corretor ativar.
  acceptInvitesEnabled   Boolean @default(false)
  withdrawInvitesEnabled Boolean @default(false)
  withdrawAfterDays      Int     @default(21)
  warmupEnabled          Boolean @default(false)
  archiveLostEnabled     Boolean @default(false)
  receivedInvitesCheckedAt DateTime?
  withdrawCheckedAt        DateTime?
  // E-mail conectado com "Entrar com Google": endereço, refresh token
  // (criptografado com SESSION_SECRET) e até onde a caixa já foi lida.
  googleEmail         String?
  googleRefreshToken  String? @db.Text
  googleHistoryId     String?
  // Plano B (senha de app via variáveis de ambiente, IMAP): último UID lido.
  emailLastUid        Int?
  emailUidValidity    String?
  linkedinNeedsReconnect Boolean @default(false)
  linkedinReconnectReason String?
}
