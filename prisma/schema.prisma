generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum LeadStatus {
  INVITE_SENT      // convite mandado, aguardando aceite
  WAITING_REPLY    // conectado; mandamos mensagem (abertura/follow-up) e o lead ainda não respondeu
  CONVERSATION_OPEN // o lead já respondeu pelo menos uma vez — conversa de verdade
  NEEDS_HUMAN      // agente pediu handoff
  QUALIFIED        // pronto para fechar
  LOST             // sem resposta / recusou
}

enum MessageSender {
  LEAD
  AGENT
  HUMAN
}

model Lead {
  id                String    @id @default(cuid())
  linkedinProfileUrl String   @unique
  linkedinProfileId  String?
  firstName         String?
  lastName          String?
  jobTitle          String?
  status            LeadStatus @default(INVITE_SENT)
  linkedinThreadId  String?   @unique
  needsHumanReason  String?
  // Quando o convite foi enviado (callback da edges.run). É o que conta pro limite
  // diário de convites — o status muda assim que o convite é aceito.
  invitedAt         DateTime?
  // Follow-ups enviados desde a última resposta do lead (zera quando ele responde).
  followUpsSent     Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  messages          Message[]
}

model Message {
  id        String        @id @default(cuid())
  lead      Lead          @relation(fields: [leadId], references: [id])
  leadId    String
  sender    MessageSender
  content   String
  linkedinMessageId String? @unique
  deliveredAt DateTime
  createdAt DateTime      @default(now())
}

model Settings {
  id                  String  @id @default("singleton")
  automationPaused    Boolean @default(true)
  dailyInviteLimit    Int     @default(18)
  dailyMessageLimit   Int     @default(25)
  linkedinIdentityId  String?
  agentInstructions   String? @db.Text
  targetAudience      String? @db.Text
  // Follow-up automático: até followUpMaxCount mensagens, uma a cada
  // followUpDelayHours sem resposta. Depois disso o lead vira LOST.
  followUpMaxCount    Int     @default(2)
  followUpDelayHours  Int     @default(48)
  // Última checagem de convites aceitos (lista de conexões) — no máximo 1x/hora.
  connectionsCheckedAt DateTime?
  linkedinNeedsReconnect Boolean @default(false)
  linkedinReconnectReason String?
}
