# Banco de dados (Vercel Postgres / Neon)
DATABASE_URL=

# Edges API (https://app.edges.run) — chave da conta e UID da identidade conectada ao LinkedIn
EDGES_API_KEY=
EDGES_IDENTITY_ID=

# Segredo que protege os endpoints de cron contra chamadas externas (obrigatório —
# sem ele o /api/cron/poll recusa todas as chamadas). O agendador envia no header
# "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# URL pública do app (sem barra no final) — usada para montar a URL de callback
# que a edges.run chama quando um convite agendado (modo async) é concluído.
APP_URL=

# Segredo enviado como header customizado nos webhooks da edges.run (configurar em
# Developer Settings > Webhooks, no dashboard da edges.run, como header
# "X-Webhook-Secret"). Obrigatório: sem ele o webhook recusa todas as chamadas,
# já que a rota fica fora do login do painel.
EDGES_WEBHOOK_SECRET=

# Login do dashboard (usuário único)
DASHBOARD_PASSWORD=
# Segredo usado para assinar o cookie de sessão do dashboard
SESSION_SECRET=

# Fase 3 (agente de IA) — Nous Portal (portal.nousresearch.com), compatível com OpenAI
NOUS_API_KEY=
# Opcionais, já vêm com valor padrão se não definidos:
# NOUS_BASE_URL=https://inference-api.nousresearch.com/v1
# Modelo das conversas (padrão: openai/gpt-6.1-sol). Se definido, vale também para as tarefas rápidas,
# a menos que NOUS_MODEL_FAST esteja definido. A escolha feita no admin vale mais que esta variável.
# NOUS_MODEL=openai/gpt-6.1-sol
# NOUS_MODEL_FAST=deepseek/deepseek-v4-flash

# Notificações push (opcional) — gere com: npx web-push generate-vapid-keys
# Sem elas o app funciona normal, só não avisa no celular/computador.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contato do responsável (exigido pelo padrão Web Push)
VAPID_SUBJECT=mailto:voce@exemplo.com

# Área de admin (/admin): instruções da IA, limites, horários, follow-up.
# Defina SÓ no seu .env.local e rode o sistema local (npm run dev) pra mexer.
# Sem esta variável no ambiente (ex.: na Vercel), /admin não existe (404).
# ADMIN_PASSWORD=

# Busca de pessoas pelo Google (Prospectar). Use UMA das duas:
# SerpApi — plano grátis de 250 buscas/mês, sem cartão (serpapi.com)
SERPAPI_API_KEY=
# Serper — alternativa com créditos pré-pagos (serper.dev)
SERPER_API_KEY=
# Teto de buscas por mês contado pelo sistema (padrão 240)
WEB_SEARCH_MONTHLY_LIMIT=240

# E-mail da secretária (opcional). O corretor conecta em Conta → "Conectar com
# Google", sem senha. Estas são as credenciais do APP (projeto no Google Cloud
# com a Gmail API; redirecionamento <APP_URL>/api/email/google/callback).
# A MESMA conexão dá acesso à Google Agenda (a secretária marca as reuniões):
# ative também a "Google Calendar API" nesse projeto e inclua o escopo
# .../auth/calendar.events na tela de consentimento. Se a tela de consentimento
# estiver em modo "Teste", o Google expira a autorização em 7 dias: publique o app.
# APP_URL também é usado na imagem de abertura dos e-mails.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# WhatsApp (Deskcomm): endereço único do servidor. Com ele definido, o cliente
# informa só a chave em Canais. Sem ele, o endereço também é pedido na tela.
DESKCOMM_URL=
# Opcional: nome no "De:" (padrão: nome do corretor)
EMAIL_FROM_NAME=
# Plano B, só se o Google não for possível: senha de app (SMTP + IMAP)
EMAIL_ADDRESS=
EMAIL_PASSWORD=
# gmail | outlook | custom (padrão: deduz pelo domínio do endereço)
EMAIL_PROVIDER=
# Só para EMAIL_PROVIDER=custom
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=
